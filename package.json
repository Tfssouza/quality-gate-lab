{
  "name": "quality-gate-lab",
  "version": "2.0.0",
  "private": true,
  "description": "Booking platform with PostgreSQL, API tests and cross-browser quality gates",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:start:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "start:web": "vite --host 127.0.0.1",
    "start": "tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "build": "npm run typecheck && vite build",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:report": "playwright show-report",
    "test:production": "node scripts/verify-production.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "25.2.3",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.4",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "express": "5.2.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15"
  }
}
